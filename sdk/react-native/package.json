{
  "name": "@edgeveda/react-native",
  "version": "1.0.0",
  "description": "On-device AI inference for React Native - LLM, Vision, Speech, Image Generation",
  "main": "lib/commonjs/index",
  "module": "lib/module/index",
  "types": "lib/typescript/index.d.ts",
  "react-native": "src/index",
  "source": "src/index",
  "files": [
    "src",
    "lib",
    "android",
    "ios",
    "cpp",
    "*.podspec",
    "!**/__tests__"
  ],
  "scripts": {
    "typescript": "tsc --noEmit",
    "lint": "eslint \"**/*.{js,ts,tsx}\"",
    "build": "bob build",
    "test": "jest"
  },
  "keywords": [
    "react-native",
    "ai",
    "llm",
    "on-device",
    "edge-ai",
    "inference",
    "whisper",
    "stable-diffusion"
  ],
  "repository": "https://github.com/ramanujammv1988/edge-veda",
  "license": "MIT",
  "peerDependencies": {
    "react": "*",
    "react-native": "*"
  },
  "devDependencies": {
    "@types/react": "^18.2.0",
    "react-native-builder-bob": "^0.23.0",
    "typescript": "^5.3.0"
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      "commonjs",
      "module",
      ["typescript", { "project": "tsconfig.build.json" }]
    ]
  }
}
